rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Tournament Matches: read by spectators and players, write by operators/admins
    match /matches/{matchId} {
      allow read: if isValidId(matchId);
      allow write: if isValidId(matchId);
    }

    // Teams (48 teams): public standings read, operator write
    match /teams/{teamId} {
      allow read: if isValidId(teamId);
      allow write: if isValidId(teamId);
    }

    // Squads: rosters read and update
    match /squads/{teamName} {
      allow read: if isValidId(teamName);
      allow write: if isValidId(teamName);
    }

    // App Settings
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId);
    }

    // Test connection probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
